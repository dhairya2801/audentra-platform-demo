# Local/preview example only. Never commit populated secrets or reuse these placeholders.
# NODE_ENV remains a compatibility fallback when AUDENTRA_ENV is not set.
AUDENTRA_ENV=development
AUTH_MODE=demo
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Institutional SSO and delegated mailbox OAuth. Register the exact callback
# URLs under API_PUBLIC_URL with each provider. Leave blank to disable a
# provider. MAIL_TOKEN_ENCRYPTION_KEY is a base64url-encoded 32-byte key and
# must be kept server-side in Secret Manager outside local development.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Development/test only. Enables the personal Microsoft-account SSO test path;
# it must remain false for preview and production.
MICROSOFT_OAUTH_ALLOW_PERSONAL_ACCOUNTS=false
MAIL_TOKEN_ENCRYPTION_KEY=

# Student OIDC proof (Google and Microsoft identity platform). Keep AUTH_MODE=demo
# until at least one provider is fully configured. For a local proof, use
# OIDC_PUBLIC_BASE_URL=http://localhost:4000 and
# OIDC_PORTAL_BASE_URL=http://localhost:3000; see ../../docs/runbooks/student-sso-local.md.
# Never commit populated client secrets.
OIDC_AUDENTRA_TENANT_ID=
OIDC_PUBLIC_BASE_URL=
OIDC_PORTAL_BASE_URL=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_TENANT_ID=

# PostgreSQL. Percent-encode reserved characters in usernames and passwords.
DATABASE_URL=postgresql://audentra:replace-me@localhost:5432/audentra
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_APPLICATION_NAME=audentra-api
DB_ECHO=false

# S3-compatible document storage (these example credentials are not real).
# Set OBJECT_STORAGE_PROVIDER=gcs on Cloud Run. It uses workload identity and
# does not need object-store access keys or secrets.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=audentra-documents
OBJECT_STORAGE_ACCESS_KEY=replace-with-object-store-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-object-store-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MAX_DOCUMENT_BYTES=10485760

# Shared only by the API and its private worker network. Use 32+ random characters.
DOCUMENT_WORKER_TOKEN=replace-with-at-least-32-random-characters
# Used to sign one-time FERPA delegate-link tokens. Use a distinct 32+ character secret.
FERPA_DELEGATE_LINK_SECRET=replace-with-at-least-32-random-characters
API_INTERNAL_URL=http://localhost:4000
API_INTERNAL_AUDIENCE=

# Demo identity and tenant routing. Production currently fails closed with demo auth.
DEMO_TENANT_ID=00000000-0000-7000-8000-000000000001
DEMO_STUDENT_ID=00000000-0000-7000-8000-000000000101
DEMO_ACTOR_ID=00000000-0000-7000-8000-000000000100
DEMO_STAFF_ACTOR_ID=00000000-0000-7000-8000-000000000901
# Demo persona allowlist. Empty (the development default) lets the sign-in panels
# open any synthetic student or staff member. Set both to restrict a deployment to
# named people — required when AUDENTRA_ENV=preview runs with AUTH_MODE=demo.
#DEMO_STUDENT_ALLOWLIST=SYN-000061
#DEMO_STAFF_ALLOWLIST=SYN-ADV-001,SYN-STF-ADV-DIR,SYN-STF-VP
TENANT_SLUG_MAP='{"aster":"00000000-0000-7000-8000-000000000001","harvard":"00000000-0000-7000-8000-000000000002"}'

# Optional AI providers. Blank keys keep deterministic/guided fallbacks enabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
OPENROUTER_DOCUMENT_MODEL=qwen/qwen3.7-flash
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME="Audentra Student Portal"
OPENROUTER_DOCUMENT_TIMEOUT_MS=120000
OPENROUTER_DOCUMENT_MAX_TOKENS=6000
OPENROUTER_DOCUMENT_REASONING_TOKENS=256
TRANSCRIPT_PARSING=openrouter
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TRANSCRIPT_TIMEOUT_MS=60000
GROQ_TRANSCRIPT_MAX_TOKENS=1400
GROQ_TRANSCRIPT_MAX_TEXT_CHARACTERS=40000
GROQ_TRANSCRIPT_REASONING_EFFORT=none

# Durable outbox worker. Each replica should have a unique WORKER_ID; if omitted,
# the process derives one from its hostname and PID.
WORKER_ID=
WORKER_CONSUMER_NAME=student-dashboard-v1
WORKER_COMMAND_TIMEOUT_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=1
AGENTIC_WORKFLOW_INTERVAL_SECONDS=300
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=10
WORKER_BASE_RETRY_MS=1000
WORKER_MAX_RETRY_MS=300000

# Explicit paths are useful outside the container; the image supplies /app defaults.
AUDENTRA_MIGRATIONS_DIR=./migrations
ONBOARDING_DOCUMENT_TEMPLATE_DIR=./assets/onboarding
PORTAL_MEDIA_DIR=./assets/portal-media
