{
  "name": "audentra-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/demo-api",
    "tools/edward-eval",
    "apps/voice-agent"
  ],
  "scripts": {
    "build": "npm run build:api && npm run build:node",
    "build:api": "uv build --directory apps/api --wheel",
    "build:node": "npm run build --workspaces --if-present",
    "test": "npm run test:api && npm run test:node",
    "test:api": "uv run --directory apps/api --locked pytest --cov=audentra --cov-report=term-missing",
    "test:api:postgres": "uv run --directory apps/api --locked pytest -m postgres",
    "test:node": "npm run test --workspaces --if-present",
    "lint": "npm run lint:api && npm run lint:node",
    "lint:api": "uv run --directory apps/api --locked ruff check src tests && uv run --directory apps/api --locked ruff format --check src tests",
    "lint:node": "npm run lint --workspaces --if-present",
    "format:api": "uv run --directory apps/api --locked ruff format src tests",
    "typecheck": "npm run typecheck:api && npm run typecheck:node",
    "typecheck:api": "uv run --directory apps/api --locked mypy src tests",
    "typecheck:node": "npm run typecheck --workspaces --if-present",
    "sync:api": "uv sync --directory apps/api --locked --all-groups",
    "dev:api": "uv run --directory apps/api --locked audentra-api",
    "dev:worker": "uv run --directory apps/api --locked audentra-worker",
    "worker:once": "uv run --directory apps/api --locked audentra-worker --once",
    "dev:demo-api": "npm --workspace @vv/demo-api run dev",
    "dev:voice-agent": "npm --workspace @vv/voice-agent run dev",
    "demo:reset": "npm --workspace @vv/demo-api run reset",
    "test:demo-api": "npm --workspace @vv/demo-api test",
    "test:assistant-core": "npm --workspace @vv/student-assistant-core test",
    "eval:edward": "node tools/edward-eval/run.mjs",
    "eval:edward:smoke": "node tools/edward-eval/run.mjs --tier smoke --no-judge --batch smoke",
    "eval:edward:core": "node tools/edward-eval/run.mjs --tier core --batch core",
    "eval:edward:full": "node tools/edward-eval/run.mjs --tier full --batch full",
    "eval:edward:staff": "node tools/edward-eval/run-staff.mjs",
    "eval:edward:staff-db": "node tools/edward-eval/staff-db/run.mjs",
    "eval:edward:university": "node tools/edward-eval/university/run.mjs",
    "eval:edward:student-v3": "node tools/edward-eval/student-v3/run.mjs",
    "eval:edward:write": "node tools/edward-eval/write/run.mjs",
    "eval:edward:write:holdout": "node tools/edward-eval/write/run.mjs --holdout",
    "eval:edward:write:bank": "node tools/edward-eval/write/export-bank.mjs",
    "eval:edward:read-gen": "node tools/edward-eval/read-gen/run.mjs",
    "eval:edward:read-gen:holdout": "node tools/edward-eval/read-gen/run.mjs --holdout",
    "eval:edward:read-gen:bank": "node tools/edward-eval/read-gen/export-bank.mjs",
    "eval:edward:compare": "node tools/edward-eval/compare.mjs",
    "eval:edward:compare-modes": "node tools/edward-eval/compare-modes.mjs",
    "eval:edward:inspect": "node tools/edward-eval/inspect.mjs",
    "eval:edward:coverage": "node tools/edward-eval/coverage.mjs",
    "eval:edward:calibrate": "node tools/edward-eval/calibrate.mjs",
    "crm:graph": "npm --workspace @vv/state-effects run generate",
    "crm:graph:check": "npm --workspace @vv/state-effects run generate:check",
    "cgc:index": "cgc --db kuzudb --path ./tmp/codegraphcontext index .",
    "cgc:update": "cgc --db kuzudb --path ./tmp/codegraphcontext update .",
    "cgc:report": "cgc --db kuzudb --path ./tmp/codegraphcontext report --output ./docs/generated/codegraphcontext-report.md",
    "db:migrate": "uv run --directory apps/api --locked audentra-migrate --migrations-dir migrations",
    "db:seed": "uv run --directory apps/api --locked audentra-seed --all",
    "db:seed:data": "uv run --directory apps/api --locked audentra-seed --data",
    "db:seed:media": "uv run --directory apps/api --locked audentra-seed --media"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "find-my-way": "^9.7.0"
  }
}
