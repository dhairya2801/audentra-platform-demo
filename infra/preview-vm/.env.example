# Audentra preview VM configuration. Copy this file to the protected VM path
# /opt/audentra-platform/shared/.env, replace every CHANGE_ME value, then set
# owner root:root and mode 0600. Never commit the populated file.

# Deployment mode is intentionally fixed by compose.yaml. These values document
# the contract and must remain exactly as shown for this synthetic preview.
AUDENTRA_ENV=preview
AUTH_MODE=demo
BROWSER_AUTH_REQUIRED=true

# Public API hostname only: no scheme, path, or port. DNS must point this name
# to the VM before Caddy can obtain a public certificate.
API_DOMAIN=api.example.com

# Exact browser origin allowed by FastAPI CORS. No trailing slash and no
# wildcard. Browser requests from this origin must use credentials: "include".
WEB_ORIGIN=https://audentra-portals-demo-web.vercel.app

# Preview-only cross-site session policy. The API combines this with HttpOnly
# and Secure cookies. Development/test and production retain SameSite=Lax.
SESSION_COOKIE_SAMESITE=none

# Image name before the immutable :<git-sha> tag. The deploy script appends the
# commit SHA. A local name avoids Artifact Registry for the initial VM test;
# later this may be REGION-docker.pkg.dev/PROJECT/REPOSITORY/api.
PLATFORM_IMAGE_REPOSITORY=audentra-platform

# PostgreSQL stays on the private Docker network. Use URL-safe values because
# Compose derives DATABASE_URL internally as:
# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
# DATABASE_URL=postgresql://audentra:REPLACE_WITH_URL_SAFE_PASSWORD@postgres:5432/audentra
POSTGRES_DB=audentra
POSTGRES_USER=audentra
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_POSTGRES_PASSWORD

# MinIO stays on the private Docker network. Its API and console are not
# published to the host. These values also configure object storage in the API.
MINIO_ROOT_USER=audentra-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=audentra-documents

# Shared only by API and worker. Generate at least 32 random characters.
DOCUMENT_WORKER_TOKEN=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS

# Private preview staff enrollment/invitation code (minimum 16 characters).
VV_STAFF_INVITATION_CODE=CHANGE_ME_PRIVATE_STAFF_CODE

# Used to sign one-time FERPA delegate-link tokens. Use a distinct 32+ character secret.
FERPA_DELEGATE_LINK_SECRET=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS

# API_INTERNAL_URL=http://api:4000
# API_INTERNAL_URL is enforced as shown above inside the Docker network.
# DATABASE_URL is also derived internally from the POSTGRES_* values above.

# Optional assistant providers. Leave keys empty for deterministic/guided
# Edward behavior and zero external model cost. A direct OpenAI key takes
# precedence over OpenRouter for assistant chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_DOCUMENT_MODEL=qwen/qwen3.7-flash
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
OPENROUTER_APP_URL=https://CHANGE_ME.vercel.app
OPENROUTER_APP_NAME=Audentra Preview

# Optional transcript provider. With no provider key, provider-backed transcript
# extraction remains unavailable while core APIs and deterministic Edward work.
TRANSCRIPT_PARSING=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Optional overrides for isolated local validation. Leave unset on the VM so
# the stable named volumes survive release updates.
# POSTGRES_VOLUME_NAME=audentra-platform-postgres-data
# MINIO_VOLUME_NAME=audentra-platform-minio-data
# CADDY_DATA_VOLUME_NAME=audentra-platform-caddy-data
# CADDY_CONFIG_VOLUME_NAME=audentra-platform-caddy-config
