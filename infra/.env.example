# Local Compose overrides. Copy to infra/.env only when changing these defaults.
POSTGRES_DB=vv_enrollment
POSTGRES_USER=vv
POSTGRES_PASSWORD=vv_local_password
POSTGRES_PORT=5432

MINIO_ROOT_USER=vv_minio
MINIO_ROOT_PASSWORD=vv_minio_password
MINIO_BUCKET=vv-documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_password
KEYCLOAK_PORT=8080
KEYCLOAK_HEALTH_PORT=9002

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# Institutional SSO and delegated mailbox OAuth (server-side secrets only).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Base64url-encoded 32-byte AES key. Use Secret Manager when deployed.
MAIL_TOKEN_ENCRYPTION_KEY=
WEB_PORT=3000
DOCUMENT_WORKER_TOKEN=change-before-any-shared-environment
VV_STAFF_INVITATION_CODE=local-staff-invitation-2027

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_STATEMENT_TIMEOUT_MS=15000
WORKER_ID=compose-worker
WORKER_CONSUMER_NAME=student-dashboard-v1
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_SECONDS=1
AGENTIC_WORKFLOW_INTERVAL_SECONDS=300
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=10
WORKER_BASE_RETRY_MS=1000
WORKER_MAX_RETRY_MS=300000
WORKER_COMMAND_TIMEOUT_SECONDS=30

# Optional. Empty keys retain deterministic navigation guidance and disable
# provider-backed extraction without exposing a server-side secret.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_DOCUMENT_MODEL=qwen/qwen3.7-flash
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
TRANSCRIPT_PARSING=openrouter
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TRANSCRIPT_TIMEOUT_MS=60000
GROQ_TRANSCRIPT_MAX_TOKENS=1400
GROQ_TRANSCRIPT_MAX_TEXT_CHARACTERS=40000
GROQ_TRANSCRIPT_REASONING_EFFORT=none

# Assistant model provider: a direct OpenAI key takes precedence over OpenRouter.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Per-turn Edward trace inspection endpoints (/internal/assistant/traces).
# Defaults on in development/test, off in preview, prohibited in production.
# ASSISTANT_TRACE_DEBUG_ENABLED=true

# LiveKit voice sessions (all-or-nothing; voice routes fail closed when unset).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# VOICE_AGENT_INTERNAL_TOKEN=
