# Development-only defaults. Copy to infra/.env only when overriding them.
POSTGRES_DB=vv_enrollment
POSTGRES_USER=vv
POSTGRES_PASSWORD=vv_local_password
POSTGRES_PORT=5432

MINIO_ROOT_USER=vv_minio
MINIO_ROOT_PASSWORD=vv_minio_password
MINIO_BUCKET=vv-documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_password
KEYCLOAK_PORT=8080
KEYCLOAK_HEALTH_PORT=9002

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=4000
WORKER_HEALTH_PORT=3002
WEB_PORT=3000

WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=10
LOG_LEVEL=info

# Optional. Keep this server-side; leaving it blank enables deterministic
# navigation guidance and stores uploads without LLM extraction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
