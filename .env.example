# Direct-process development defaults. Never reuse these credentials outside a local machine.
AUDENTRA_ENV=development
AUTH_MODE=demo
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Institutional SSO and delegated mailbox OAuth (server-side secrets only).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Base64url-encoded 32-byte AES key. Use Secret Manager when deployed.
MAIL_TOKEN_ENCRYPTION_KEY=

DATABASE_URL=postgresql://vv:vv_local_password@localhost:5432/vv_enrollment
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false

# s3 is the local/compatibility default. Cloud Run uses gcs and Application
# Default Credentials from its runtime service account, so no HMAC keys are set.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=vv-documents
OBJECT_STORAGE_ACCESS_KEY=vv_minio
OBJECT_STORAGE_SECRET_KEY=vv_minio_password
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MAX_DOCUMENT_BYTES=10485760

DEMO_TENANT_ID=00000000-0000-7000-8000-000000000001
DEMO_STUDENT_ID=00000000-0000-7000-8000-000000000101
DEMO_ACTOR_ID=00000000-0000-7000-8000-000000000100
DEMO_STAFF_ACTOR_ID=00000000-0000-7000-8000-000000000901
# Local-only default. Preview environments generate and protect a private code.
VV_STAFF_INVITATION_CODE=local-staff-invitation-2027
# Optional JSON object mapping tenant slugs to UUIDs. Leave the variable unset
# to retain the built-in local mappings.
# TENANT_SLUG_MAP={"aster":"00000000-0000-7000-8000-000000000001"}

DOCUMENT_WORKER_TOKEN=local-development-document-worker-token
API_INTERNAL_URL=http://localhost:4000
# Set to the private Cloud Run API URL for Cloud Run worker jobs.
API_INTERNAL_AUDIENCE=
WORKER_ID=local-worker
WORKER_CONSUMER_NAME=student-dashboard-v1
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_SECONDS=1
AGENTIC_WORKFLOW_INTERVAL_SECONDS=300
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=10
WORKER_BASE_RETRY_MS=1000
WORKER_MAX_RETRY_MS=300000
WORKER_COMMAND_TIMEOUT_SECONDS=30

# Optional provider settings. Keep API keys server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
OPENROUTER_DOCUMENT_MODEL=qwen/qwen3.7-flash
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Aster Student Portal
OPENROUTER_DOCUMENT_TIMEOUT_MS=120000
OPENROUTER_DOCUMENT_MAX_TOKENS=6000
OPENROUTER_DOCUMENT_REASONING_TOKENS=256
TRANSCRIPT_PARSING=openrouter
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TRANSCRIPT_TIMEOUT_MS=60000
GROQ_TRANSCRIPT_MAX_TOKENS=1400
GROQ_TRANSCRIPT_MAX_TEXT_CHARACTERS=40000
GROQ_TRANSCRIPT_REASONING_EFFORT=none
